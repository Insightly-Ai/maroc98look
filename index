              borderTop: `1px solid rgba(184,134,11,0.2)`,
              textAlign: "center",
            }}>
              <button
                onClick={() => { setImage(null); setImageBase64(null); setResult(null); fileRef.current.click(); }}
                style={{
                  background: "transparent",
                  border: `1px solid rgba(184,134,11,0.4)`,
                  borderRadius: "8px",
                  color: FLAG_COLORS.gold,
                  padding: "10px 24px",
                  fontFamily: "'Lato', sans-serif",
                  fontSize: "13px",
                  cursor: "pointer",
                  letterSpacing: "2px",
                  textTransform: "uppercase",
                  transition: "all 0.2s",
                }}
              >
                Probeer een andere foto
              </button>
            </div>
          </div>
        )}

        {/* Footer */}
        <div style={{
          textAlign: "center",
          marginTop: "60px",
          color: "rgba(232,245,224,0.25)",
          fontFamily: "'Lato', sans-serif",
          fontSize: "12px",
          letterSpacing: "2px",
        }}>
          <MoroccanStar size={16} style={{ display: "inline-block", verticalAlign: "middle", margin: "0 8px", opacity: 0.4 }} />
          MAROC 98 · WK FRANKRIJK · LES LIONS DE L'ATLAS
          <MoroccanStar size={16} style={{ display: "inline-block", verticalAlign: "middle", margin: "0 8px", opacity: 0.4 }} />
        </div>
      </div>

      {/* Red stripe bottom */}
      <div style={{ height: "5px", background: `linear-gradient(90deg, ${FLAG_COLORS.red}, #e63946, ${FLAG_COLORS.red})`, position: "absolute", bottom: 0, left: 0, right: 0 }} />
    </div>
  );
}
